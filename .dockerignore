# Keep build contexts small and, above all, keep secrets and user data out of
# image layers. Everything here is either regenerable, machine-specific, or
# must never be copied into an image.

# Secrets — never, under any circumstances.
.env
.env.*
!.env.example

# Local IFC models: large, licensed, and the user's own data.
ifc/
*.ifc
!frontend/tests/fixtures/*.ifc

# Generated artifacts, mounted at runtime instead of baked in.
model_assets/
model_semantics/
!model_assets/README.md
!model_semantics/README.md

# Version control and CI
.git/
.github/
.gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
backend/.venv/
backend/.pytest-tmp/
backend/logs/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
frontend/*.tsbuildinfo

# Tooling / editors / OS
.claude/
.runtime/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docs and process material — not needed to build or run anything.
#
# Anchored with a leading slash so these match ONLY at the context root. An
# unanchored `*.md` would still only match top-level files under Docker's
# matching rules, but the intent must be unmistakable: `backend/app/llm/prompts/`
# is a directory of `.md` prompt files loaded at runtime, and excluding those
# would break every LLM call.
/docs/
/specs/
/tasks/
/*.md
!/README.md
