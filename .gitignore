.env

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Run logs and experiment traces — private output, never committed. The
# repository-root `logs/` was tracked historically (task29 archive) and is
# purged from history along with backend/app/evaluation/query_trace.jsonl.
logs/
backend/logs/
*.jsonl.log

# Backend Poetry virtualenv + local test temp dirs (Task 09)
backend/.venv/
.venv/
backend/.pytest-tmp/

# Prepared viewer artifacts (large generated Fragments; spec_v006 §9, Task 11).
# The real model artifacts are generated locally and must not be committed, but
# small tracked test fixtures under model_assets/fixtures/ are kept.
model_assets/*
!model_assets/fixtures/
!model_assets/README.md

# Generated semantic manifests (task25 §2.1, §8). One deterministic JSON per
# (source_model_id, fingerprint), rebuilt by `ifc_to_db()` from the imported
# data — local generated artifacts, never committed. Small tracked fixtures
# under model_semantics/fixtures/ are kept for tests.
model_semantics/*
!model_semantics/fixtures/
!model_semantics/README.md

# Frontend OpenAPI snapshot is regenerable from the backend; keep it out of Git.
frontend_openapi_snapshot.json

# Local dev launcher runtime record (Task 12) — ephemeral PIDs/ports, no secrets.
.runtime/

# User IFC models (Task 34). `ifc/` is the documented drop location for local
# building models: large (21-170 MB here), usually licensed, and never
# redistributed by this repository. Only its README is tracked. The tests use
# the 1.6 KB frontend/tests/fixtures/smoke-wall.ifc fixture instead.
ifc/*
!ifc/README.md

# Build artifacts — regenerable, and none belong in version control.
build/
dist/
test-results/

# NOTE: frontend/demo-site/public/model.frag is deliberately NOT ignored. It is
# the demo's 3D payload (spec_v013 §8) — 5.5 MB, redistributed under CC BY 4.0
# with attribution in demo-site/public/ATTRIBUTION.txt and on the page itself.

# Frontend build output and incremental typecheck state — regenerable.
frontend/dist/
frontend/dist-demo/
frontend/*.tsbuildinfo
frontend/playwright-report/
frontend/test-results/

# Owner-run live evaluation transcripts are regenerable and may spend tokens.
evaluation/results/test_query_*.md
/BIMtrieval_support
